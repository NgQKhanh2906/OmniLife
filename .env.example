# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU TOÀN HỆ THỐNG - OMNILIFE PERSONAL OS
# Sao chép file này thành .env (tại root hoặc backend/) và .env.local (tại frontend/)
# Tuyệt đối không đưa thông tin mật thật lên kho lưu trữ Git
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH MÁY CHỦ BACKEND & PROFILE (SPRING BOOT 3.3 / JAVA 21)
# ------------------------------------------------------------------------------
# Cổng lắng nghe của dịch vụ Backend REST API
SERVER_PORT=8080

# Môi trường hoạt động của Spring Boot (local | prod)
SPRING_PROFILES_ACTIVE=local

# Địa chỉ gốc của ứng dụng Frontend phục vụ chuyển hướng sau xác thực OAuth2
APP_FRONTEND_URL=http://localhost:3000

# Danh sách các nguồn (Origin) được phép gọi API qua cấu hình CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH CƠ SỞ DỮ LIỆU QUAN HỆ (MYSQL 8.0 / MYSQL WORKBENCH / DOCKER)
# ------------------------------------------------------------------------------
# Địa chỉ máy chủ MySQL (localhost khi chạy trực tiếp hoặc omnilife-mysql khi dùng Docker Compose)
DB_HOST=localhost

# Cổng kết nối MySQL (mặc định 3306)
DB_PORT=3306

# Tên cơ sở dữ liệu (Schema) sử dụng bảng mã utf8mb4_unicode_ci
DB_NAME=omnilife_db

# Tài khoản quản trị hoặc người dùng kết nối MySQL
DB_USERNAME=root

# Mật khẩu kết nối MySQL tại máy trạm cục bộ
DB_PASSWORD=your_local_mysql_password

# Mật khẩu root dùng để khởi tạo container MySQL trong docker-compose.yml
MYSQL_ROOT_PASSWORD=root_password_2026

# Tên database tự động khởi tạo trong container MySQL
MYSQL_DATABASE=omnilife_db

# Múi giờ chuẩn cấp hệ thống cơ sở dữ liệu
TZ=UTC

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH BẢO MẬT STATELESS JWT & REFRESH TOKEN ROTATION
# ------------------------------------------------------------------------------
# Chuỗi khóa bí mật ký HMAC-SHA256 dài tối thiểu 64 ký tự (256-bit trở lên)
JWT_SECRET_KEY=7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a

# Thời hạn hiệu lực của Access Token tính bằng mili-giây (900000 ms = 15 phút)
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

# Thời hạn hiệu lực của Refresh Token tính bằng mili-giây (604800000 ms = 7 ngày)
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Tên HttpOnly Cookie lưu trữ Refresh Token trên trình duyệt
JWT_REFRESH_COOKIE_NAME=omnilife_rt

# Bật cờ Secure cho Cookie (đặt là false ở môi trường HTTP local, đặt là true ở HTTPS production)
JWT_REFRESH_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH GOOGLE OAUTH2 & GOOGLE CALENDAR API V3
# ------------------------------------------------------------------------------
# Client ID cấp từ Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Client Secret cấp từ Google Cloud Console
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Đường dẫn Callback nhận Authorization Code từ Google OAuth2
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH GỬI EMAIL NHẮC LỊCH HỌC & HẠN CHÓT (GMAIL SMTP)
# ------------------------------------------------------------------------------
# Máy chủ SMTP của Gmail
MAIL_HOST=smtp.gmail.com

# Cổng SMTP chuẩn hỗ trợ STARTTLS
MAIL_PORT=587

# Địa chỉ Gmail dùng để gửi thông báo
MAIL_USERNAME=your_email@gmail.com

# Mật khẩu ứng dụng 16 ký tự của Gmail (Google App Password)
MAIL_APP_PASSWORD=your_16_char_gmail_app_password

# Địa chỉ người gửi hiển thị trong tiêu đề Email
MAIL_FROM_ADDRESS=noreply@omnilife.local

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH LƯU TRỮ & BÓC TÁCH TÀI LIỆU HỌC TẬP (PDFBOX / POI)
# ------------------------------------------------------------------------------
# Dung lượng tối đa cho phép khi tải lên giáo trình/đề cương (.pdf, .docx, .txt, .md)
MAX_FILE_UPLOAD_SIZE=15MB

# Thư mục lưu trữ tạm thời các tài liệu học tập tải lên
STUDY_MATERIAL_STORAGE_DIR=./uploads/study-materials

# ------------------------------------------------------------------------------
# 7. CẤU HÌNH FRONTEND & CỬA SỔ NỔI DOCUMENT PIP MINI HUD (NEXT.JS 14)
# ------------------------------------------------------------------------------
# Đường dẫn gốc tới RESTful API v1 của Backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Đường dẫn khởi tạo luồng đăng nhập một chạm với Google OAuth2
NEXT_PUBLIC_OAUTH2_GOOGLE_AUTH_URL=http://localhost:8080/oauth2/authorization/google

# Tên hiển thị của ứng dụng trên giao diện người dùng
NEXT_PUBLIC_APP_NAME=OmniLife OS

# Múi giờ mặc định hiển thị ở tầng giao diện người dùng
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Chiều rộng mặc định (px) khi khởi chạy cửa sổ nổi Always-on-Top Mini HUD
NEXT_PUBLIC_HUD_DEFAULT_WIDTH=340

# Chiều cao mặc định (px) khi khởi chạy cửa sổ nổi Always-on-Top Mini HUD
NEXT_PUBLIC_HUD_DEFAULT_HEIGHT=460
